    {
      "name": "Conversation Sessions CRUD",
      "item": [
        {
          "name": "POST /api/v1/sessions/save - Save Session",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Dynamic session isolation: generate fresh UUID for each run to prevent overwriting persistent conversations",
                  "var freshSessionId = pm.variables.replaceIn('{{$guid}}');",
                  "pm.environment.set(\"test_session_id\", freshSessionId);",
                  "",
                  "// Ensure isolated test user account exists prior to saving session",
                  "var backendUrl = pm.environment.get(\"backend_url\") || \"http://localhost:8000\";",
                  "var testEmail = pm.environment.get(\"test_user_email\") || \"qa_tester@nityageeta.internal\";",
                  "pm.sendRequest({",
                  "    url: backendUrl + \"/api/v1/auth/register\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\" },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            email: testEmail,",
                  "            full_name: \"QA Newman Isolated Runner\",",
                  "            password: \"TemporaryQaPassword123!\"",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    // 200 (created) or 400 (already exists) both confirm account availability",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns success response\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{test_session_id}}\",\n  \"user_email\": \"{{test_user_email}}\",\n  \"title\": \"Postman Newman Dialogue Test\",\n  \"messages\": [\n    {\n      \"id\": \"msg-1\",\n      \"sender\": \"user\",\n      \"text\": \"What is Nishkama Karma in Chapter 2?\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{backend_url}}/api/v1/sessions/save",
              "host": ["{{backend_url}}"],
              "path": ["api", "v1", "sessions", "save"]
            }
          }
        },
