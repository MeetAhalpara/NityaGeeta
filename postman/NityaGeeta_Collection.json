        {
          "name": "POST /api/v1/auth/register - Provision Isolated Test User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 Created or 400 Already Exists\", function () {",
                  "    pm.expect([200, 400]).to.include(pm.response.code);",
                  "});",
                  "pm.test(\"Isolated test user is provisioned and ready\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(jsonData.exists).to.be.true;",
                  "        pm.expect(jsonData.user.email).to.eql(pm.environment.get(\"test_user_email\") || \"qa_tester@nityageeta.internal\");",
                  "    } else {",
                  "        pm.expect(jsonData.detail).to.include(\"already exists\");",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
