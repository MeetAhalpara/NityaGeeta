    {
      "name": "Next.js BFF & Contact Form",
      "item": [
        {
          "name": "POST /api/contact - Valid Submission Contract",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Mail safety guard: skip live contact email submission by default",
                  "// to prevent dispatching real emails through Resend/SendGrid/SMTP.",
                  "// Enable only when targeting an isolated mail sink or stub by setting enable_live_email_dispatch=true.",
                  "if (pm.environment.get(\"enable_live_email_dispatch\") !== \"true\") {",
                  "    console.warn(\"[SKIPPED] POST /api/contact live dispatch skipped to prevent sending real email. Configure isolated mail sink and set enable_live_email_dispatch=true in environment to execute.\");",
                  "    if (pm.execution && typeof pm.execution.skipRequest === \"function\") {",
                  "        pm.execution.skipRequest();",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response) {",
                  "    pm.test(\"Status code is 200 OK or 503 (if unconfigured in prod)\", function () {",
                  "        pm.expect([200, 503]).to.include(pm.response.code);",
                  "    });",
                  "    if (pm.response.code === 200) {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData).to.have.property(\"ticketId\");",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Newman Automated Runner\",\n  \"email\": \"newman@nityageeta.internal\",\n  \"category\": \"ai_feedback\",\n  \"message\": \"Automated API test submission via Newman test suite.\"\n}"
            },
            "url": {
              "raw": "{{frontend_url}}/api/contact",
              "host": ["{{frontend_url}}"],
              "path": ["api", "contact"]
            }
          }
        },
